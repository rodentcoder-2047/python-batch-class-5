#list of games
Games = [ "Cricket" , "football" , "hockey", "Chess" ,]
#slicing a list 
print(Games[1:3])
#updation and deletion 
Games.append("Volleyball")
print(Games)
Games.insert(2 , "Basketball")
print(Games)
 
#Deleting values from list
Games.pop()
print(Games)

#iteration 
for Game in Games:
    print(Game)
for i in range(len(Games)):
    print(f"list{i} has game" , Games[i])


